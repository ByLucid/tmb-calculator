---
import { craftableCount, equipmentCount } from "../data/catalog";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Raw crafting ingredient and equipment cost calculator for The Majestic Bees on Roblox." />
		<meta name="theme-color" content="#0b1020" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
		<title>The Majestic Bees Crafting Calculator</title>
	</head>

	<body>
		<div class="background-glow glow-one"></div>
		<div class="background-glow glow-two"></div>

		<header class="topbar">
			<div class="brand">
				<div class="bee-logo">🐝</div>
				<div>
					<div class="brand-title">The Majestic Bees</div>
					<div class="brand-subtitle">Crafting Calculator</div>
				</div>
			</div>
			<div class="recipe-count">
				<span>{craftableCount}</span> craftables
				<span class="count-divider">•</span>
				<span>{equipmentCount}</span> equipment
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="eyebrow">TMB CRAFTING TOOL</div>
				<h1>
					Calculate your
					<span>raw ingredients.</span>
				</h1>
				<p>
					Add Mixer recipes, equipment, bags, tools, planters, or raw materials.
					The calculator recursively breaks every craft down into one combined base-material tally.
				</p>
			</section>

<div class="calculator-layout">
	<section class="panel builder-panel">
		<div class="panel-heading">
			<div>
				<p class="panel-kicker">CRAFTING LIST</p>
				<h2>What are you crafting?</h2>
			</div>

			<button id="clearButton" class="text-button" type="button">
				Clear all
			</button>
		</div>

		<div class="add-item-box">
			<div class="item-filter-tabs" aria-label="Item type">
				<button
					class="item-filter active"
					type="button"
					data-filter="all"
				>
					All
				</button>
				<button
					class="item-filter"
					type="button"
					data-filter="equipment"
				>
					Equipment
				</button>
				<button
					class="item-filter"
					type="button"
					data-filter="mixer"
				>
					Mixer
				</button>
				<button
					class="item-filter"
					type="button"
					data-filter="raw"
				>
					Raw Materials
				</button>
			</div>

			<label for="itemSearch">Item</label>

			<div class="search-wrapper">
				<input
					id="itemSearch"
					type="text"
					placeholder="Search for an item, shop, or type..."
					autocomplete="off"
				/>

				<div id="searchResults" class="search-results hidden"></div>
			</div>

			<div class="quantity-area">
				<div class="quantity-field">
					<label for="quantityInput">Quantity</label>

					<div class="quantity-control">
						<button id="minusButton" type="button">−</button>

						<input
							id="quantityInput"
							type="number"
							min="1"
							step="1"
							value="1"
						/>

						<button id="plusButton" type="button">+</button>
					</div>
				</div>

				<button id="addButton" class="primary-button" type="button">
					<span>+</span>
					Add item
				</button>
			</div>
		</div>

		<div id="emptyCraftList" class="empty-state">
			<div class="empty-icon">🍯</div>

			<div>
				<strong>Your crafting list is empty</strong>
				<p>
					Choose Equipment, Mixer, Raw Materials, or All,
					then add whatever you need.
				</p>
			</div>
		</div>

		<div id="craftList" class="craft-list"></div>

		<button id="calculateButton" class="calculate-button" type="button">
			<span>Calculate Materials</span>
			<span class="arrow">→</span>
		</button>
	</section>

	<section class="panel results-panel">
		<div class="panel-heading results-heading">
			<div>
				<p class="panel-kicker">RESULTS</p>
				<h2>Materials needed</h2>
			</div>

			<button
				id="copyButton"
				class="copy-button"
				type="button"
				disabled
			>
				Copy
			</button>
		</div>

		<div class="tabs">
			<button
				class="tab active"
				type="button"
				data-tab="raw"
			>
				Raw Materials
			</button>

			<button
				class="tab"
				type="button"
				data-tab="crafts"
			>
				Crafting Breakdown
			</button>
		</div>

		<div id="resultEmpty" class="result-empty">
			<div class="result-empty-icon">🧪</div>
			<h3>Nothing calculated yet</h3>
			<p>
				Add some items and hit
				<strong>Calculate Materials</strong>.
			</p>
		</div>

		<div id="rawResults" class="results-list hidden"></div>
		<div id="craftResults" class="results-list hidden"></div>
	</section>
</div>


			<footer>
				<p>Fan-made calculator for <strong>The Majestic Bees</strong> on Roblox.</p>
			</footer>
		</main>

<script>
	import {
		allItemNames,
		getItemCategoryLabel,
		getItemFilterType,
		matchesItemFilter,
	} from "../data/catalog";
	import type { CraftRequest, IngredientMap, ItemFilter } from "../data/types";
	import { calculateMaterials } from "../lib/calculator";
	import { formatCompact, formatFull } from "../lib/format";
	import { getItemIcon } from "../lib/icons";

	function requiredElement<T extends HTMLElement>(
		id: string,
	): T {
		const element = document.getElementById(id);

		if (!element) {
			throw new Error(`Missing required element #${id}`);
		}

		return element as T;
	}

	const craftingList: CraftRequest[] = [];

	let selectedItem = "";
	let activeItemFilter: ItemFilter = "all";
	let latestRawTotals: IngredientMap = {};

	const itemSearch =
		requiredElement<HTMLInputElement>("itemSearch");
	const searchResults =
		requiredElement<HTMLDivElement>("searchResults");
	const quantityInput =
		requiredElement<HTMLInputElement>("quantityInput");

	const addButton =
		requiredElement<HTMLButtonElement>("addButton");
	const minusButton =
		requiredElement<HTMLButtonElement>("minusButton");
	const plusButton =
		requiredElement<HTMLButtonElement>("plusButton");

	const craftListElement =
		requiredElement<HTMLDivElement>("craftList");
	const emptyCraftList =
		requiredElement<HTMLDivElement>("emptyCraftList");

	const calculateButton =
		requiredElement<HTMLButtonElement>("calculateButton");
	const clearButton =
		requiredElement<HTMLButtonElement>("clearButton");

	const rawResults =
		requiredElement<HTMLDivElement>("rawResults");
	const craftResults =
		requiredElement<HTMLDivElement>("craftResults");
	const resultEmpty =
		requiredElement<HTMLDivElement>("resultEmpty");

	const copyButton =
		requiredElement<HTMLButtonElement>("copyButton");

	const itemFilterButtons =
		document.querySelectorAll<HTMLButtonElement>(".item-filter");

	const resultTabs =
		document.querySelectorAll<HTMLButtonElement>(".tab");

	function getVisibleItems(query = ""): string[] {
		const normalized = query.trim().toLowerCase();

		return allItemNames.filter((item) => {
			if (!matchesItemFilter(item, activeItemFilter)) {
				return false;
			}

			const category = getItemCategoryLabel(item).toLowerCase();

			return (
				item.toLowerCase().includes(normalized) ||
				category.includes(normalized)
			);
		});
	}

	function showSearchResults(query = ""): void {
		const matches = getVisibleItems(query);

		searchResults.innerHTML = "";

		if (matches.length === 0) {
			const empty = document.createElement("div");
			empty.className = "search-empty";
			empty.textContent = "No matching items";
			searchResults.appendChild(empty);
		} else {
			for (const item of matches) {
				const button = document.createElement("button");
				button.type = "button";
				button.className = "search-option";

				const name = document.createElement("span");
				name.className = "search-option-name";
				name.textContent = item;

				const badge = document.createElement("span");
				badge.className =
					`search-option-badge ${getItemFilterType(item)}`;
				badge.textContent = getItemCategoryLabel(item);

				button.appendChild(name);
				button.appendChild(badge);

				button.addEventListener("click", () => {
					selectedItem = item;
					itemSearch.value = item;
					searchResults.classList.add("hidden");
				});

				searchResults.appendChild(button);
			}
		}

		searchResults.classList.remove("hidden");
	}

	itemFilterButtons.forEach((button) => {
		button.addEventListener("click", () => {
			activeItemFilter =
				(button.dataset.filter as ItemFilter | undefined) ??
				"all";

			itemFilterButtons.forEach((otherButton) => {
				otherButton.classList.toggle(
					"active",
					otherButton === button,
				);
			});

			selectedItem = "";
			itemSearch.value = "";
			showSearchResults("");
			itemSearch.focus();
		});
	});

	itemSearch.addEventListener("focus", () => {
		showSearchResults(itemSearch.value);
	});

	itemSearch.addEventListener("input", () => {
		selectedItem = "";

		const exactMatch = getVisibleItems(itemSearch.value).find(
			(item) =>
				item.toLowerCase() ===
				itemSearch.value.trim().toLowerCase(),
		);

		if (exactMatch) {
			selectedItem = exactMatch;
		}

		showSearchResults(itemSearch.value);
	});

	document.addEventListener("click", (event) => {
		const target = event.target;

		if (
			target instanceof Element &&
			!target.closest(".search-wrapper") &&
			!target.closest(".item-filter-tabs")
		) {
			searchResults.classList.add("hidden");
		}
	});

	function getQuantity(): bigint {
		const value = quantityInput.value.trim();

		try {
			const quantity = BigInt(value || "1");
			return quantity >= 1n ? quantity : 1n;
		} catch {
			return 1n;
		}
	}

	minusButton.addEventListener("click", () => {
		const next = getQuantity() - 1n;
		quantityInput.value =
			(next < 1n ? 1n : next).toString();
	});

	plusButton.addEventListener("click", () => {
		quantityInput.value = (getQuantity() + 1n).toString();
	});

	function addSelectedItem(): void {
		if (!selectedItem) {
			const typed = itemSearch.value.trim();

			const exactMatch = getVisibleItems(typed).find(
				(item) =>
					item.toLowerCase() === typed.toLowerCase(),
			);

			if (exactMatch) {
				selectedItem = exactMatch;
			}
		}

		if (!selectedItem) {
			itemSearch.focus();
			showSearchResults(itemSearch.value);
			return;
		}

		const quantity = getQuantity();

		const existing = craftingList.find(
			(entry) => entry.item === selectedItem,
		);

		if (existing) {
			existing.quantity += quantity;
		} else {
			craftingList.push({
				item: selectedItem,
				quantity,
			});
		}

		selectedItem = "";
		itemSearch.value = "";
		quantityInput.value = "1";

		renderCraftList();
	}

	addButton.addEventListener("click", addSelectedItem);

	itemSearch.addEventListener("keydown", (event) => {
		if (event.key === "Enter") {
			event.preventDefault();
			addSelectedItem();
		}
	});

	function renderCraftList(): void {
		craftListElement.innerHTML = "";

		emptyCraftList.classList.toggle(
			"hidden",
			craftingList.length > 0,
		);

		craftingList.forEach((entry, index) => {
			const row = document.createElement("div");
			row.className = "craft-row";

			const left = document.createElement("div");
			left.className = "craft-row-left";

			const icon = document.createElement("div");
			icon.className = "item-icon";
			icon.textContent = getItemIcon(entry.item);

			const textWrapper = document.createElement("div");

			const name = document.createElement("strong");
			name.textContent = entry.item;

			const sub = document.createElement("span");
			sub.textContent = getItemCategoryLabel(entry.item);

			textWrapper.appendChild(name);
			textWrapper.appendChild(sub);

			left.appendChild(icon);
			left.appendChild(textWrapper);

			const right = document.createElement("div");
			right.className = "craft-row-right";

			const quantity = document.createElement("span");
			quantity.className = "craft-quantity";
			quantity.textContent =
				`×${formatFull(entry.quantity)}`;

			const remove = document.createElement("button");
			remove.type = "button";
			remove.className = "remove-button";
			remove.textContent = "×";
			remove.setAttribute(
				"aria-label",
				`Remove ${entry.item}`,
			);

			remove.addEventListener("click", () => {
				craftingList.splice(index, 1);
				renderCraftList();
			});

			right.appendChild(quantity);
			right.appendChild(remove);

			row.appendChild(left);
			row.appendChild(right);

			craftListElement.appendChild(row);
		});
	}

	clearButton.addEventListener("click", () => {
		craftingList.length = 0;
		renderCraftList();
		clearResults();
	});

	function calculateEverything(): void {
		if (craftingList.length === 0) {
			return;
		}

		try {
			const { rawTotals, craftTotals } =
				calculateMaterials(craftingList);

			latestRawTotals = rawTotals;
			renderResults(rawTotals, craftTotals);
		} catch (error) {
			console.error(error);
			alert(
				error instanceof Error
					? error.message
					: "Unable to calculate materials.",
			);
		}
	}

	calculateButton.addEventListener(
		"click",
		calculateEverything,
	);

	function sortedEntries(
		totals: IngredientMap,
	): [string, bigint][] {
		return Object.entries(totals).sort(
			([nameA, amountA], [nameB, amountB]) => {
				if (nameA === "Honey") return -1;
				if (nameB === "Honey") return 1;

				if (amountA !== amountB) {
					return amountA > amountB ? -1 : 1;
				}

				return nameA.localeCompare(nameB);
			},
		);
	}

	function renderResults(
		rawTotals: IngredientMap,
		craftTotals: IngredientMap,
	): void {
		resultEmpty.classList.add("hidden");
		rawResults.classList.remove("hidden");
		craftResults.classList.add("hidden");
		copyButton.disabled = false;

		renderResultList(rawResults, rawTotals, true);
		renderResultList(craftResults, craftTotals, false);

		resultTabs.forEach((tab) => {
			tab.classList.toggle(
				"active",
				tab.dataset.tab === "raw",
			);
		});
	}

	function renderResultList(
		container: HTMLDivElement,
		totals: IngredientMap,
		rawMode: boolean,
	): void {
		container.innerHTML = "";

		const entries = sortedEntries(totals);

		if (entries.length === 0) {
			const none = document.createElement("div");
			none.className = "empty-breakdown";
			none.textContent = rawMode
				? "No raw materials are required for this selection."
				: "No crafting steps to display.";
			container.appendChild(none);
			return;
		}

		for (const [item, amount] of entries) {
			const row = document.createElement("div");
			row.className = "result-row";

			const identity = document.createElement("div");
			identity.className = "result-identity";

			const icon = document.createElement("div");
			icon.className = "result-icon";
			icon.textContent = getItemIcon(item);

			const text = document.createElement("div");

			const name = document.createElement("strong");
			name.textContent = item;

			const type = document.createElement("span");
			type.textContent = rawMode
				? item === "Honey"
					? "Currency"
					: "Raw ingredient"
				: getItemCategoryLabel(item);

			text.appendChild(name);
			text.appendChild(type);

			identity.appendChild(icon);
			identity.appendChild(text);

			const amountWrapper =
				document.createElement("div");
			amountWrapper.className = "result-amount";

			const formatted = document.createElement("strong");
			formatted.textContent = formatCompact(amount);

			const full = document.createElement("span");
			full.textContent = formatFull(amount);

			amountWrapper.appendChild(formatted);

			if (formatted.textContent !== full.textContent) {
				amountWrapper.appendChild(full);
			}

			row.appendChild(identity);
			row.appendChild(amountWrapper);

			container.appendChild(row);
		}
	}

	function clearResults(): void {
		latestRawTotals = {};

		rawResults.innerHTML = "";
		craftResults.innerHTML = "";

		rawResults.classList.add("hidden");
		craftResults.classList.add("hidden");

		resultEmpty.classList.remove("hidden");
		copyButton.disabled = true;
	}

	resultTabs.forEach((tab) => {
		tab.addEventListener("click", () => {
			if (!resultEmpty.classList.contains("hidden")) {
				return;
			}

			const selectedTab = tab.dataset.tab;

			resultTabs.forEach((button) => {
				button.classList.toggle(
					"active",
					button === tab,
				);
			});

			rawResults.classList.toggle(
				"hidden",
				selectedTab !== "raw",
			);

			craftResults.classList.toggle(
				"hidden",
				selectedTab !== "crafts",
			);
		});
	});

	copyButton.addEventListener("click", async () => {
		if (!Object.keys(latestRawTotals).length) {
			return;
		}

		const lines = [
			"The Majestic Bees - Raw Materials",
			"--------------------------------",
		];

		for (const [item, amount] of sortedEntries(latestRawTotals)) {
			lines.push(`${item}: ${formatFull(amount)}`);
		}

		try {
			await navigator.clipboard.writeText(lines.join("\n"));

			copyButton.textContent = "Copied!";

			window.setTimeout(() => {
				copyButton.textContent = "Copy";
			}, 1400);
		} catch {
			copyButton.textContent = "Copy failed";
		}
	});
</script>

	</body>
</html>

<style is:global>
:root {
	--trans-blue: #5BCEFA;
	--trans-pink: #F5A9B8;
	--trans-white: #FFFFFF;
	--bg-deep: #090d18;
	--bg-soft: #101625;
	font-family:
		Inter,
		ui-sans-serif,
		system-ui,
		-apple-system,
		BlinkMacSystemFont,
		"Segoe UI",
		sans-serif;
	color: #f8fafc;
	background: #090d18;
	font-synthesis: none;
	text-rendering: optimizeLegibility;
}

* {
	box-sizing: border-box;
}

html {
	min-height: 100%;
	background: #090d18;
}

body {
	margin: 0;
	min-height: 100vh;
	overflow-x: hidden;
	background:
		radial-gradient(
			circle at 50% -20%,
			rgba(91, 206, 250, 0.14),
			transparent 42%
		),
		linear-gradient(180deg, #0b1020 0%, #080b16 100%);
}

button,
input {
	font: inherit;
}

button {
	cursor: pointer;
}

.hidden {
	display: none !important;
}

.background-glow {
	position: fixed;
	width: 500px;
	height: 500px;
	border-radius: 999px;
	filter: blur(120px);
	pointer-events: none;
	z-index: 0;
	opacity: 0.11;
}

.glow-one {
	background: #5BCEFA;
	top: -260px;
	left: -100px;
}

.glow-two {
	background: #F5A9B8;
	bottom: -320px;
	right: -130px;
}

.topbar {
	position: relative;
	z-index: 5;
	height: 82px;
	padding: 0 42px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	border-bottom: 1px solid rgba(255, 255, 255, 0.07);
	background: rgba(8, 11, 18, 0.74);
	backdrop-filter: blur(20px);
}

.brand {
	display: flex;
	align-items: center;
	gap: 13px;
}

.bee-logo {
	width: 46px;
	height: 46px;
	display: grid;
	place-items: center;
	border-radius: 14px;
	font-size: 25px;
	background: linear-gradient(145deg, var(--trans-blue), var(--trans-white) 50%, var(--trans-pink));
	box-shadow:
		0 8px 24px rgba(245, 169, 184, 0.22),
		inset 0 1px rgba(255, 255, 255, 0.3);
}

.brand-title {
	font-size: 15px;
	font-weight: 800;
	letter-spacing: -0.02em;
}

.brand-subtitle {
	margin-top: 2px;
	font-size: 12px;
	color: #858b99;
}

.recipe-count {
	padding: 8px 13px;
	border: 1px solid rgba(255, 255, 255, 0.08);
	border-radius: 999px;
	font-size: 12px;
	font-weight: 700;
	color: #aeb4c0;
	background: rgba(255, 255, 255, 0.035);
}

.recipe-count span {
	color: #5BCEFA;
}

.count-divider {
	margin: 0 4px;
	color: #555c68 !important;
}

main {
	position: relative;
	z-index: 1;
	width: min(1220px, calc(100% - 40px));
	margin: 0 auto;
}

.hero {
	max-width: 760px;
	padding: 78px 0 52px;
}

.eyebrow,
.panel-kicker {
	margin: 0 0 11px;
	font-size: 11px;
	font-weight: 900;
	letter-spacing: 0.18em;
	color: #F5A9B8;
}

.hero h1 {
	max-width: 760px;
	margin: 0;
	font-size: clamp(42px, 6vw, 72px);
	line-height: 1.08;
	letter-spacing: -0.065em;
	font-weight: 900;
	color: #f8fafc;
}

.hero h1 span {
	display: block;
	background: linear-gradient(90deg, var(--trans-blue), var(--trans-white) 50%, var(--trans-pink));
	-webkit-background-clip: text;
	background-clip: text;
	color: transparent;
}

.hero > p {
	max-width: 650px;
	margin: 24px 0 0;
	font-size: 16px;
	line-height: 1.75;
	color: #9096a5;
}

.calculator-layout {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(390px, 0.82fr);
	gap: 20px;
	align-items: start;
}

.panel {
	border: 1px solid rgba(255, 255, 255, 0.075);
	border-radius: 24px;
	background:
		linear-gradient(
			145deg,
			rgba(255, 255, 255, 0.043),
			rgba(255, 255, 255, 0.018)
		);
	box-shadow:
		0 24px 70px rgba(0, 0, 0, 0.22),
		inset 0 1px rgba(255, 255, 255, 0.04);
	overflow: visible;
}

.builder-panel,
.results-panel {
	padding: 27px;
}

.results-panel {
	position: sticky;
	top: 22px;
}

.panel-heading {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 15px;
	margin-bottom: 24px;
}

.panel-heading h2 {
	margin: 0;
	font-size: 22px;
	letter-spacing: -0.035em;
}

.panel-kicker {
	margin-bottom: 7px;
}

.text-button,
