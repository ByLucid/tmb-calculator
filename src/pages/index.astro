<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Raw crafting ingredient calculator for The Majestic Bees on Roblox."
		/>
		<title>The Majestic Bees Crafting Calculator</title>
	</head>

	<body>
		<div class="background-glow glow-one"></div>
		<div class="background-glow glow-two"></div>

		<header class="topbar">
			<div class="brand">
				<div class="bee-logo">🐝</div>

				<div>
					<div class="brand-title">The Majestic Bees</div>
					<div class="brand-subtitle">Crafting Calculator</div>
				</div>
			</div>

			<div class="recipe-count">
				<span id="recipeCount">27</span> recipes
			</div>
		</header>

		<main>
			<section class="hero">
				<div class="eyebrow">TMB CRAFTING TOOL</div>

				<h1>
					Calculate your
					<span>raw ingredients.</span>
				</h1>

				<p>
					Add anything you want to craft and the calculator will recursively
					break every recipe down into its true base materials.
				</p>
			</section>

			<div class="calculator-layout">
				<section class="panel builder-panel">
					<div class="panel-heading">
						<div>
							<p class="panel-kicker">CRAFTING LIST</p>
							<h2>What are you crafting?</h2>
						</div>

						<button id="clearButton" class="text-button" type="button">
							Clear all
						</button>
					</div>

					<div class="add-item-box">
						<label for="itemSearch">Item</label>

						<div class="search-wrapper">
							<input
								id="itemSearch"
								type="text"
								placeholder="Search for an item..."
								autocomplete="off"
							/>

							<div id="searchResults" class="search-results hidden"></div>
						</div>

						<div class="quantity-area">
							<div class="quantity-field">
								<label for="quantityInput">Quantity</label>

								<div class="quantity-control">
									<button id="minusButton" type="button">−</button>

									<input
										id="quantityInput"
										type="number"
										min="1"
										step="1"
										value="1"
									/>

									<button id="plusButton" type="button">+</button>
								</div>
							</div>

							<button id="addButton" class="primary-button" type="button">
								<span>+</span>
								Add item
							</button>
						</div>
					</div>

					<div id="emptyCraftList" class="empty-state">
						<div class="empty-icon">🍯</div>

						<div>
							<strong>Your crafting list is empty</strong>
							<p>Search for an item above and add it to begin.</p>
						</div>
					</div>

					<div id="craftList" class="craft-list"></div>

					<button id="calculateButton" class="calculate-button" type="button">
						<span>Calculate Materials</span>
						<span class="arrow">→</span>
					</button>
				</section>

				<section class="panel results-panel">
					<div class="panel-heading results-heading">
						<div>
							<p class="panel-kicker">RESULTS</p>
							<h2>Materials needed</h2>
						</div>

						<button
							id="copyButton"
							class="copy-button"
							type="button"
							disabled
						>
							Copy
						</button>
					</div>

					<div class="tabs">
						<button
							class="tab active"
							type="button"
							data-tab="raw"
						>
							Raw Materials
						</button>

						<button
							class="tab"
							type="button"
							data-tab="crafts"
						>
							Crafting Breakdown
						</button>
					</div>

					<div id="resultEmpty" class="result-empty">
						<div class="result-empty-icon">🧪</div>
						<h3>Nothing calculated yet</h3>
						<p>
							Add some recipes and hit
							<strong>Calculate Materials</strong>.
						</p>
					</div>

					<div id="rawResults" class="results-list hidden"></div>
					<div id="craftResults" class="results-list hidden"></div>
				</section>
			</div>

			<footer>
				<p>
					Fan-made calculator for
					<strong>The Majestic Bees</strong> on Roblox.
				</p>
			</footer>
		</main>

		<script>
			/*
				==================================================
				RECIPE DATABASE
				==================================================

				Anything that DOES NOT have a recipe here is treated
				as a raw/base ingredient.

				All numbers use BigInt so gigantic Honey values stay exact.
			*/

			const recipes = {
				"Treat": {
					"Honey": 10_000n,
				},

				"Converter": {
					"Honey": 500_000n,
					"Royal Jelly": 25n,
					"Strawberry": 50n,
					"Blueberry": 50n,
					"Seed": 50n,
					"Pine Cone": 50n,
				},

				"Rare Starflower": {
					"Honey": 500_000n,
					"Starflower": 2n,
					"Royal Jelly": 10n,
				},

				"Epic Starflower": {
					"Honey": 1_000_000n,
					"Rare Starflower": 3n,
					"Royal Jelly": 20n,
				},

				"Legendary Starflower": {
					"Honey": 2_500_000n,
					"Epic Starflower": 4n,
					"Royal Jelly": 50n,
				},

				"Mythic Starflower": {
					"Honey": 10_000_000n,
					"Legendary Starflower": 5n,
					"Royal Jelly": 250n,
				},

				"Exp Essence": {
					"Honey": 10_000n,
					"Exp Orb": 5n,
				},

				"Night Bell": {
					"Honey": 5_000_000n,
					"Lunar Treat": 250n,
					"Shiny Jelly": 3n,
				},

				"Lunar Ticket": {
					"Ticket": 200n,
				},

				"Singularity Essence": {
					"Honey": 250_000_000n,
					"Exp Essence": 250n,
					"Lunar Essence": 250n,
					"Wind Essence": 250n,
					"Water Essence": 250n,
					"Fire Essence": 250n,
					"Lunar Shard": 3n,
				},

				"Dice": {
					"Honey": 5_000_000n,
					"Lunar Essence": 10n,
					"Exp Essence": 5n,
					"Royal Jelly": 5n,
				},

				"Double Dice": {
					"Honey": 15_000_000n,
					"Lunar Essence": 20n,
					"Exp Essence": 15n,
					"Dice": 3n,
				},

				"Triple Dice": {
					"Honey": 50_000_000n,
					"Lunar Essence": 40n,
					"Exp Essence": 30n,
					"Double Dice": 3n,
				},

				"Glitter": {
					"Honey": 10_000_000n,
					"Lunar Essence": 20n,
					"Exp Essence": 15n,
					"Dice": 1n,
					"Shiny Jelly": 1n,
				},

				"Majestic Cocktail": {
					"Honey": 25_000_000n,
					"Moon Extract": 2n,
					"Bamboo Flask": 3n,
					"Strawberry Extract": 7n,
					"Blueberry Extract": 7n,
					"Cone Extract": 7n,
					"Seed Oil": 7n,
					"Shiny Jelly": 2n,
				},

				"Moon Extract": {
					"Honey": 1_000_000n,
					"Lunar Treat": 50n,
					"Royal Jelly": 50n,
				},

				"Bamboo Flask": {
					"Honey": 250_000n,
					"Bamboo": 50n,
					"Royal Jelly": 10n,
				},

				"Cone Extract": {
					"Honey": 25_000n,
					"Pine Cone": 25n,
					"Wind Essence": 15n,
					"Royal Jelly": 5n,
				},

				"Strawberry Extract": {
					"Honey": 25_000n,
					"Strawberry": 25n,
					"Fire Essence": 15n,
					"Royal Jelly": 5n,
				},

				"Blueberry Extract": {
					"Honey": 25_000n,
					"Blueberry": 25n,
					"Water Essence": 15n,
					"Royal Jelly": 5n,
				},

				"Seed Oil": {
					"Honey": 50_000n,
					"Seed": 25n,
					"Royal Jelly": 5n,
				},

				"Shiny Jelly": {
					"Honey": 5_000_000n,
					"Lunar Treat": 10n,
					"Royal Jelly": 150n,
				},

				"Bamboo Boba Tea": {
					"Honey": 1_000_000n,
					"Bamboo": 75n,
					"Seed": 50n,
					"Pine Cone": 50n,
					"Lunar Treat": 50n,
					"Glitter": 1n,
				},

				"Lunar Cocktail": {
					"Honey": 25_000_000_000n,
					"Lunar Essence": 250n,
					"Moon Extract": 5n,
					"Shiny Jelly": 5n,
					"Lunar Shard": 1n,
				},

				"Pot'O'Vegetation": {
					"Honey": 250_000_000_000_000n,
					"Foaming Carrot Juice": 2n,
					"Golden Carrot": 1n,
					"Golden Apple": 1n,
					"Gardener's Bundle": 5n,
					"Singularity Essence": 1n,
				},

				"Foaming Carrot Juice": {
					"Honey": 12_000_000_000_000n,
					"Carrot Treat": 500n,
					"Magic Carrot": 12n,
					"Majestic Cocktail": 3n,
					"Bamboo Boba Tea": 5n,
					"Triple Dice": 3n,
				},

				"Rich Apple Juice": {
					"Honey": 5_000_000_000_000n,
					"Apple Treat": 250n,
					"Strawberry Extract": 35n,
					"Converter": 20n,
					"Moon Extract": 3n,
					"Dice": 3n,
				},
			};

			const itemNames = Object.keys(recipes).sort((a, b) =>
				a.localeCompare(b)
			);

			const craftingList = [];

			let selectedItem = "";
			let latestRawTotals = {};
			let latestCraftTotals = {};

			const itemSearch = document.getElementById("itemSearch");
			const searchResults = document.getElementById("searchResults");
			const quantityInput = document.getElementById("quantityInput");

			const addButton = document.getElementById("addButton");
			const minusButton = document.getElementById("minusButton");
			const plusButton = document.getElementById("plusButton");

			const craftListElement = document.getElementById("craftList");
			const emptyCraftList = document.getElementById("emptyCraftList");

			const calculateButton = document.getElementById("calculateButton");
			const clearButton = document.getElementById("clearButton");

			const rawResults = document.getElementById("rawResults");
			const craftResults = document.getElementById("craftResults");
			const resultEmpty = document.getElementById("resultEmpty");

			const copyButton = document.getElementById("copyButton");

			const recipeCount = document.getElementById("recipeCount");

			recipeCount.textContent = itemNames.length.toString();

			/*
				==================================================
				SEARCH
				==================================================
			*/

			function showSearchResults(query = "") {
				const normalized = query.trim().toLowerCase();

				const matches = itemNames.filter((item) =>
					item.toLowerCase().includes(normalized)
				);

				searchResults.innerHTML = "";

				if (matches.length === 0) {
					const empty = document.createElement("div");
					empty.className = "search-empty";
					empty.textContent = "No matching recipes";
					searchResults.appendChild(empty);
				} else {
					matches.forEach((item) => {
						const button = document.createElement("button");
						button.type = "button";
						button.className = "search-option";
						button.textContent = item;

						button.addEventListener("click", () => {
							selectedItem = item;
							itemSearch.value = item;
							searchResults.classList.add("hidden");
						});

						searchResults.appendChild(button);
					});
				}

				searchResults.classList.remove("hidden");
			}

			itemSearch.addEventListener("focus", () => {
				showSearchResults(itemSearch.value);
			});

			itemSearch.addEventListener("input", () => {
				selectedItem = "";

				const exactMatch = itemNames.find(
					(item) =>
						item.toLowerCase() === itemSearch.value.trim().toLowerCase()
				);

				if (exactMatch) {
					selectedItem = exactMatch;
				}

				showSearchResults(itemSearch.value);
			});

			document.addEventListener("click", (event) => {
				if (
					!event.target.closest(".search-wrapper")
				) {
					searchResults.classList.add("hidden");
				}
			});

			/*
				==================================================
				QUANTITY
				==================================================
			*/

			function getQuantity() {
				const parsed = parseInt(quantityInput.value, 10);

				if (!Number.isFinite(parsed) || parsed < 1) {
					return 1;
				}

				return Math.floor(parsed);
			}

			minusButton.addEventListener("click", () => {
				quantityInput.value = Math.max(1, getQuantity() - 1).toString();
			});

			plusButton.addEventListener("click", () => {
				quantityInput.value = (getQuantity() + 1).toString();
			});

			/*
				==================================================
				CRAFT LIST
				==================================================
			*/

			function addSelectedItem() {
				if (!selectedItem) {
					const typed = itemSearch.value.trim();

					const exactMatch = itemNames.find(
						(item) => item.toLowerCase() === typed.toLowerCase()
					);

					if (exactMatch) {
						selectedItem = exactMatch;
					}
				}

				if (!selectedItem) {
					itemSearch.focus();
					showSearchResults(itemSearch.value);
					return;
				}

				const quantity = BigInt(getQuantity());

				const existing = craftingList.find(
					(entry) => entry.item === selectedItem
				);

				if (existing) {
					existing.quantity += quantity;
				} else {
					craftingList.push({
						item: selectedItem,
						quantity,
					});
				}

				selectedItem = "";
				itemSearch.value = "";
				quantityInput.value = "1";

				renderCraftList();
			}

			addButton.addEventListener("click", addSelectedItem);

			itemSearch.addEventListener("keydown", (event) => {
				if (event.key === "Enter") {
					event.preventDefault();
					addSelectedItem();
				}
			});

			function renderCraftList() {
				craftListElement.innerHTML = "";

				emptyCraftList.classList.toggle(
					"hidden",
					craftingList.length > 0
				);

				craftingList.forEach((entry, index) => {
					const row = document.createElement("div");
					row.className = "craft-row";

					const left = document.createElement("div");
					left.className = "craft-row-left";

					const icon = document.createElement("div");
					icon.className = "item-icon";
					icon.textContent = getItemEmoji(entry.item);

					const textWrapper = document.createElement("div");

					const name = document.createElement("strong");
					name.textContent = entry.item;

					const sub = document.createElement("span");
					sub.textContent = "Crafting recipe";

					textWrapper.appendChild(name);
					textWrapper.appendChild(sub);

					left.appendChild(icon);
					left.appendChild(textWrapper);

					const right = document.createElement("div");
					right.className = "craft-row-right";

					const quantity = document.createElement("span");
					quantity.className = "craft-quantity";
					quantity.textContent = `×${formatFull(entry.quantity)}`;

					const remove = document.createElement("button");
					remove.type = "button";
					remove.className = "remove-button";
					remove.textContent = "×";
					remove.setAttribute("aria-label", `Remove ${entry.item}`);

					remove.addEventListener("click", () => {
						craftingList.splice(index, 1);
						renderCraftList();
					});

					right.appendChild(quantity);
					right.appendChild(remove);

					row.appendChild(left);
					row.appendChild(right);

					craftListElement.appendChild(row);
				});
			}

			clearButton.addEventListener("click", () => {
				craftingList.length = 0;
				renderCraftList();
				clearResults();
			});

			/*
				==================================================
				RECURSIVE CALCULATOR
				==================================================
			*/

			function addToTotals(totals, item, amount) {
				if (!totals[item]) {
					totals[item] = 0n;
				}

				totals[item] += amount;
			}

			function expandRecipe(
				item,
				quantity,
				rawTotals,
				craftTotals,
				path = []
			) {
				/*
					This also protects us if we accidentally create
					a circular recipe later.
				*/
				if (path.includes(item)) {
					console.error(
						`Circular recipe detected: ${[
							...path,
							item,
						].join(" -> ")}`
					);

					return;
				}

				const recipe = recipes[item];

				/*
					If the item has no recipe, it is a RAW MATERIAL.
				*/
				if (!recipe) {
					addToTotals(rawTotals, item, quantity);
					return;
				}

				/*
					Record this as something that must be crafted.
				*/
				addToTotals(craftTotals, item, quantity);

				const nextPath = [...path, item];

				for (const [ingredient, amount] of Object.entries(recipe)) {
					expandRecipe(
						ingredient,
						quantity * amount,
						rawTotals,
						craftTotals,
						nextPath
					);
				}
			}

			function calculateEverything() {
				if (craftingList.length === 0) {
					return;
				}

				const rawTotals = {};
				const craftTotals = {};

				for (const entry of craftingList) {
					expandRecipe(
						entry.item,
						entry.quantity,
						rawTotals,
						craftTotals
					);
				}

				latestRawTotals = rawTotals;
				latestCraftTotals = craftTotals;

				renderResults(rawTotals, craftTotals);
			}

			calculateButton.addEventListener("click", calculateEverything);

			/*
				==================================================
				RESULT DISPLAY
				==================================================
			*/

			function renderResults(rawTotals, craftTotals) {
				resultEmpty.classList.add("hidden");

				rawResults.classList.remove("hidden");
				craftResults.classList.add("hidden");

				copyButton.disabled = false;

				renderResultList(rawResults, rawTotals, true);
				renderResultList(craftResults, craftTotals, false);

				document.querySelectorAll(".tab").forEach((tab) => {
					tab.classList.toggle(
						"active",
						tab.dataset.tab === "raw"
					);
				});
			}

			function renderResultList(container, totals, rawMode) {
				container.innerHTML = "";

				const sortedEntries = Object.entries(totals).sort(
					([nameA, amountA], [nameB, amountB]) => {
						if (nameA === "Honey") return -1;
						if (nameB === "Honey") return 1;

						if (amountA !== amountB) {
							return amountA > amountB ? -1 : 1;
						}

						return nameA.localeCompare(nameB);
					}
				);

				if (sortedEntries.length === 0) {
					const none = document.createElement("div");
					none.className = "empty-breakdown";
					none.textContent = "No materials to display.";
					container.appendChild(none);
					return;
				}

				sortedEntries.forEach(([item, amount]) => {
					const row = document.createElement("div");
					row.className = "result-row";

					const identity = document.createElement("div");
					identity.className = "result-identity";

					const icon = document.createElement("div");
					icon.className = "result-icon";
					icon.textContent = getItemEmoji(item);

					const text = document.createElement("div");

					const name = document.createElement("strong");
					name.textContent = item;

					const type = document.createElement("span");
					type.textContent = rawMode
						? item === "Honey"
							? "Currency"
							: "Raw ingredient"
						: "Craft this";

					text.appendChild(name);
					text.appendChild(type);

					identity.appendChild(icon);
					identity.appendChild(text);

					const amountWrapper = document.createElement("div");
					amountWrapper.className = "result-amount";

					const formatted = document.createElement("strong");
					formatted.textContent = formatCompact(amount);

					const full = document.createElement("span");
					full.textContent = formatFull(amount);

					amountWrapper.appendChild(formatted);

					if (formatted.textContent !== full.textContent) {
						amountWrapper.appendChild(full);
					}

					row.appendChild(identity);
					row.appendChild(amountWrapper);

					container.appendChild(row);
				});
			}

			function clearResults() {
				latestRawTotals = {};
				latestCraftTotals = {};

				rawResults.innerHTML = "";
				craftResults.innerHTML = "";

				rawResults.classList.add("hidden");
				craftResults.classList.add("hidden");

				resultEmpty.classList.remove("hidden");

				copyButton.disabled = true;
			}

			/*
				==================================================
				TABS
				==================================================
			*/

			document.querySelectorAll(".tab").forEach((tab) => {
				tab.addEventListener("click", () => {
					if (resultEmpty.classList.contains("hidden") === false) {
						return;
					}

					const selectedTab = tab.dataset.tab;

					document.querySelectorAll(".tab").forEach((button) => {
						button.classList.toggle(
							"active",
							button === tab
						);
					});

					rawResults.classList.toggle(
						"hidden",
						selectedTab !== "raw"
					);

					craftResults.classList.toggle(
						"hidden",
						selectedTab !== "crafts"
					);
				});
			});

			/*
				==================================================
				NUMBER FORMATTING
				==================================================
			*/

			const numberUnits = [
				{
					value: 1_000_000_000_000_000_000_000_000n,
					suffix: "SP",
				},
				{
					value: 1_000_000_000_000_000_000_000n,
					suffix: "SX",
				},
				{
					value: 1_000_000_000_000_000_000n,
					suffix: "QI",
				},
				{
					value: 1_000_000_000_000_000n,
					suffix: "QD",
				},
				{
					value: 1_000_000_000_000n,
					suffix: "T",
				},
				{
					value: 1_000_000_000n,
					suffix: "B",
				},
				{
					value: 1_000_000n,
					suffix: "M",
				},
				{
					value: 1_000n,
					suffix: "K",
				},
			];

			function formatCompact(value) {
				const absolute = value < 0n ? -value : value;

				for (const unit of numberUnits) {
					if (absolute >= unit.value) {
						const whole = absolute / unit.value;

						const remainder =
							absolute % unit.value;

						const decimals =
							(remainder * 1000n) /
							unit.value;

						let decimalString = decimals
							.toString()
							.padStart(3, "0");

						decimalString = decimalString.replace(
							/0+$/,
							""
						);

						const sign = value < 0n ? "-" : "";

						return decimalString
							? `${sign}${whole}.${decimalString}${unit.suffix}`
							: `${sign}${whole}${unit.suffix}`;
					}
				}

				return formatFull(value);
			}

			function formatFull(value) {
				return value
					.toString()
					.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
			}

			/*
				==================================================
				COPY RESULTS
				==================================================
			*/

			copyButton.addEventListener("click", async () => {
				if (!Object.keys(latestRawTotals).length) {
					return;
				}

				const lines = [];

				lines.push("The Majestic Bees - Raw Materials");
				lines.push("--------------------------------");

				const entries = Object.entries(latestRawTotals).sort(
					([a], [b]) => {
						if (a === "Honey") return -1;
						if (b === "Honey") return 1;
						return a.localeCompare(b);
					}
				);

				for (const [item, amount] of entries) {
					lines.push(`${item}: ${formatFull(amount)}`);
				}

				try {
					await navigator.clipboard.writeText(
						lines.join("\n")
					);

					const previous = copyButton.textContent;

					copyButton.textContent = "Copied!";

					setTimeout(() => {
						copyButton.textContent = previous;
					}, 1400);
				} catch {
					copyButton.textContent = "Copy failed";
				}
			});

			/*
